<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/loom_accent_soft" />
            <corners android:radius="@dimen/loom_radius_button" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/loom_accent_glow" />
                    <corners android:radius="@dimen/loom_radius_button" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="@color/loom_accent"
                        android:endColor="@color/loom_accent_soft" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

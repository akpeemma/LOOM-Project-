<?xml version="1.0" encoding="utf-8"?>
<!-- LOOM header pill: accent-tinted capsule with glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/loom_accent_glow" />
            <corners android:radius="@dimen/loom_radius_pill" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/loom_accent_soft"
                android:endColor="@color/loom_accent_dim" />
            <corners android:radius="@dimen/loom_radius_pill" />
        </shape>
    </item>
</layer-list>

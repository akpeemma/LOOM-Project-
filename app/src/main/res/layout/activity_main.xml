    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/loom_background">

    <FrameLayout
        android:id="@id/loom_main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.loom.assistant.presentation.designsystem.LoomBottomNav
        android:id="@id/loom_main_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loom_bottom_nav_height" />

</LinearLayout>
